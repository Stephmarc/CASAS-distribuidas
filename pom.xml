<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 1. HERENCIA DE SPRING BOOT -->
    <!-- Esto le dice a Maven que use las versiones oficiales y probadas de Spring Boot -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/> <!-- Busca en el repositorio de Maven -->
    </parent>

    <groupId>pe.edu.upeu.casaonada</groupId>
    <artifactId>casa-o-nada</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>CASA O NADA</name>

    <properties>
        <!-- 2. PROPIEDADES CENTRALIZADAS -->
        <!-- Basado en tus logs, usas Java 21 -->
        <java.version>21</java.version>
        <!-- Versión de Spring Cloud compatible con Boot 3.2.x -->
        <spring-cloud.version>2023.0.3</spring-cloud.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 3. GESTIÓN DE DEPENDENCIAS DE SPRING CLOUD -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <!-- <module>services/cliente-ms</module> -->
        <!-- <module>services/orden-ms</module> -->
        <!-- <module>services/notificacion-ms</module> -->
        <module>infra/casa-config</module> 
        <module>services/propiedad-ms</module>
        <module>services/agente-ms</module>
        <module>services/visita-ms</module>
        <module>services/reserva-ms</module>
        <module>services/pago-ms</module>
        <module>services/contrato-ms</module>
        <module>infra/casa-eureka</module>
        <module>infra/casa-gateway</module>
    </modules>

    <build>
        <!-- 4. GESTIÓN DE PLUGINS -->
        <!-- Así el plugin de Spring Boot se hereda a todos los módulos sin dar warnings -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>