{
  "uid": "casas-u2",
  "title": "CASAS \u00b7 Operaci\u00f3n distribuida",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "trace",
        "type": "textbox",
        "label": "Trace ID",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Servicios disponibles",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "up{job=\"casas\"}",
          "refId": "A",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Peticiones por servicio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(application)(rate(http_server_requests_seconds_count[2m]))",
          "refId": "A",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Errores HTTP 5xx",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(application)(rate(http_server_requests_seconds_count{status=~\"5..\"}[2m]))",
          "refId": "A",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Latencia p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le,application)(rate(http_server_requests_seconds_bucket[2m])))",
          "refId": "A",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Memoria JVM",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(application)(jvm_memory_used_bytes{area=\"heap\"})",
          "refId": "A",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Logs correlacionados \u00b7 filtra por traceId",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "expr": "{job=\"casas\"} |= \"$trace\"",
          "refId": "A",
          "legendFormat": "{{application}}"
        }
      ]
    }
  ]
}